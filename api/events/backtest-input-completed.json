{
  "title": "BacktestInputCompleted",
  "description": "Published by market-data-service after all candle events for one backtest run are published.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "producer",
    "run_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "const": "backtest.input.completed"
    },
    "event_version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "const": "market-data-service"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candle_count",
        "symbol",
        "timeframe",
        "completed_at"
      ],
      "properties": {
        "candle_count": {
          "type": "integer",
          "minimum": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "timeframe": {
          "type": "string",
          "minLength": 1
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}